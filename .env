# ─────────────────────────────────────────────
#  WAMO Backend – Environment Variables
# ─────────────────────────────────────────────

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/wamo
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/wamo
MONGODB_URI=mongodb://127.0.0.1:27017/wamo

# Server port (frontend expects 3001)
PORT=3001

# JWT secret – change this to a long random string in production
JWT_SECRET=wamo_super_secret_jwt_key_change_me

# Maximum file sizes
MAX_RESUME_SIZE_MB=5
MAX_PHOTO_SIZE_MB=2

# CORS origin (your frontend URL)
CORS_ORIGIN=http://localhost:3000
